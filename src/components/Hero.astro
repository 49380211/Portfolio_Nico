---
// Portada. El nombre se parte letra por letra (`.c`) para que GSAP las escalone
// al entrar; el `.slot` del medio es el hueco donde aterriza la pelota 3D.
//
// OJO: el <h1> tiene que quedar en una sola línea. Las letras son inline-block,
// así que cualquier salto de línea entre ellas se vuelve un espacio visible.
---

<header class="hero" id="inicio">
  <div class="hwrap">
    <span class="tag">Portfolio · 2026</span>
    <h1 class="name" aria-label="Nicolás Atalah"><span class="l" aria-hidden="true"><span class="c">N</span><span class="c">I</span><span class="c">C</span><span class="c"><span class="slot"></span></span><span class="c">L</span><span class="c">Á</span><span class="c">S</span></span><span class="l" aria-hidden="true"><span class="c">A</span><span class="c">T</span><span class="c">A</span><span class="c">L</span><span class="c">A</span><span class="c">H</span></span></h1>
    <p class="sub"><b>Estudiante · Futuro ingeniero industrial · Deportista</b> — Buenos Aires</p>
  </div>
</header>
