---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/sections/About.astro';
import Education from '../components/sections/Education.astro';
import Projects from '../components/sections/Projects.astro';
import Sports from '../components/sections/Sports.astro';
import Skills from '../components/sections/Skills.astro';
import Contact from '../components/sections/Contact.astro';
import TennisBall from '../components/TennisBall.astro';
import Toast from '../components/Toast.astro';
---

<BaseLayout
  title="Nicolás Atalah"
  description="Portfolio de Nicolás Atalah: estudiante, futuro ingeniero industrial y deportista. Buenos Aires."
>
  <Nav />
  <Hero />

  <main>
    <About />
    <Education />
    <Projects />
    <Sports />
    <Skills />
  </main>

  <Contact />

  <!-- Fuera del flujo: la pelota y el aviso son `position: fixed`. -->
  <TennisBall />
  <Toast />

  <!-- Librerías externas: se cargan antes del script principal, que es un módulo
       y por lo tanto siempre corre después. -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
    import '../scripts/main.js';
  </script>
</BaseLayout>
